opam-version: "2.0"
authors: [ "Silvio Macías Sánchez" ]
maintainer: [ "Silvio Macías Sánchez" ]
license: "LicenseRef-All-Rights-Reserved"
synopsis: "Cristalizar pipelines de IA: pedir el método, no el resultado"
depends: [ "ocaml" {>= "5.0"} "dune" {>= "3.21"} ]
build: [ "dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test} ]
