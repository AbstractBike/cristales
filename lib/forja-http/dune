; El prompt de nucleación va dentro del binario: el horno lo rellena.

(rule
 (with-stdout-to
  prompt.ml
  (progn
   (echo "let cristalizar = {forja|")
   (cat %{project_root}/prompts/cristalizar.md)
   (echo "|forja}\n"))))
